{
  "name": "openoctopus-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 next dev",
    "dev:web": "NODE_USE_ENV_PROXY=1 next dev",
    "dev:worker": "npm run dev --workspace @openoctopus/gateway-worker",
    "build": "next build",
    "build:web": "next build",
    "build:worker": "npm run build --workspace @openoctopus/gateway-worker",
    "build:all": "npm run build:web && npm run build:worker",
    "start": "next start",
    "lint": "eslint",
    "lint:web": "eslint",
    "smoke:images": "node tests/api-smoke/scripts/images.generations.mjs",
    "smoke:api": "npm run smoke:images"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.102.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
